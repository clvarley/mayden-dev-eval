{% extends 'base.html.twig' %}

{% block body %}
<main class="wrapper">
    <header class="list-header">
        <h1 class="list-header__title" id="list-title">{{ title }}</h1>
        <a class="list-header__return" href="{{ path('view.list.all') }}">Back</a>
    </header>
    <ul aria-labelledby="list-title" class="list-items">
        {% for item in items %}
            <li class="list-item">
                <span>{{ item.text }}</span>
                <form
                    class="form-delete"
                    method="POST"
                    action="{{ path('form.item.delete', { listId: listId, itemId: item.getId() }) }}"
                    enctype="application/x-www-form-urlencoded"
                >
                    <button type="submit" class="form-delete__submit">Remove</button>
                </form>
            </li>
        {% endfor %}
    </ul>
    <form 
        class="form-add"
        method="POST"
        action="{{ path('form.list.add', { listId: listId }) }}"
        enctype="application/x-www-form-urlencoded"
    >
        <div class="form-group">
            <label class="form-group__label" for="input-new-item">Add new item</label>
            <input
                id="input-new-item"
                class="form-group__input"
                type="text"
                name="text"
                minlength="1"
                maxlength="64"
                placeholder="Butter, Milk, Soap..."
            />
        </div>
        <button type="submit" class="form-add__submit">Save</button>
    </form>
</main>
{% endblock %}